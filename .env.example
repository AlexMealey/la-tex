# Copy to .env next to docker-compose.yml and edit:  cp .env.example .env
# Every setting is optional; the values shown are the defaults.

# --- Network ---
# Interface and port the editor listens on. Use 127.0.0.1 when a reverse proxy on this host
# (or the Caddy service below) is the only way in.
BIND_ADDRESS=0.0.0.0
HOST_PORT=14738

# Proxy hops to trust for the client IP (login throttling) and HTTPS detection. Leave false while
# the port above is reachable directly; set to 1 behind a single reverse proxy with BIND_ADDRESS=127.0.0.1.
TRUST_PROXY=false

# HTTPS-only session cookies. Logging in over plain http:// only works from localhost while this is
# true. Setting it to false sends passwords unencrypted over the network.
COOKIE_SECURE=true

# --- Built-in HTTPS (Caddy, automatic Let's Encrypt certificates) ---
# Point DOMAIN's DNS at this server, open ports 80 and 443, then uncomment both lines.
# With Caddy in front you can also set BIND_ADDRESS=127.0.0.1 and TRUST_PROXY=1.
# COMPOSE_PROFILES=https
# DOMAIN=latex.example.com

# --- Files ---
# Owner of the files in ./data. Use the output of `id -u` / `id -g` for the user who owns the clone.
PUID=1000
PGID=1000

# --- Compiling and sessions ---
COMPILE_CONCURRENCY=2
COMPILE_TIMEOUT_MS=60000
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
